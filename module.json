{
  "id": "breweries-chat-edit",
  "title": "Breweries' Chat Edit",
  "version": "1.0.0",
  "esmodules": [
    "scripts/setup.mjs"
  ],
  "styles": [
    "styles/chatedit-styles.css"
  ],
  "socket": true,
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "json",
        "hbs"
      ],
      "paths": [
        "styles",
        "lang",
        "templates"
      ]
    }
  },
  "url": "https://github.com/breweries-wa/foundry-chat-edit",
  "manifest": "https://github.com/breweries-wa/foundry-chat-edit/releases/latest/download/module.json",
  "download": "https://github.com/breweries-wa/foundry-chat-edit/releases/latest/download/module.zip",
  "authors": [
    {
      "name": "breweries-wa",
      "url": "https://github.com/breweries-wa",
      "flags": {}
    },
    {
      "name": "Scorpious187",
      "url": "https://github.com/nscarpinatodev",
      "flags": {}
    },
    {
      "name": "alakshana",
      "discord": "alakshana",
      "url": "https://github.com/etiquettestartshere",
      "flags": {}
    },
    {
      "name": "rydoq",
      "discord": "rydoq",
      "url": "https://github.com/rydoq",
      "flags": {}
    }
  ]
}
